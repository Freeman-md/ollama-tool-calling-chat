{
  "name": "freemancodz-phone-orbit",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "studio": "remotion studio src/index.tsx",
    "check": "tsc --noEmit",
    "audio": "python3 scripts/audio.py",
    "render": "remotion render src/index.tsx PhoneOrbit out/freemancodz-phone-orbit.mp4 --scale=1.5 --codec=h264 --crf=18 --color-space=bt709"
  },
  "dependencies": {
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "remotion": "4.0.540"
  },
  "devDependencies": {
    "@remotion/bundler": "4.0.540",
    "@remotion/cli": "4.0.540",
    "@remotion/player": "4.0.540",
    "@remotion/renderer": "4.0.540",
    "@types/node": "22.20.5",
    "@types/react": "19.2.18",
    "@types/react-dom": "19.2.4",
    "esbuild": "0.28.1",
    "playwright-core": "1.65.0",
    "typescript": "5.9.3"
  }
}
